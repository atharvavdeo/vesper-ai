# Copy to .env for local development. Never commit .env or replace placeholders
# with real credentials in documentation, screenshots, or client-side variables.

# Project data
SITE_DB_PATH=../data/site.db
PROJECT_ID=P1

# Clerk — account authentication for the /app operational console
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_SITE_URL=https://your-deployed-site.example
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
FREE_COMMAND_LIMIT=3
# false locally; set true in every public deployment
ENFORCE_FREE_COMMAND_LIMIT=false
DEMO_SEED_EMAIL=atharva.v.deo@gmail.com

# Rime TTS — organizer configuration
RIME_API_KEY=replace_with_rime_secret
RIME_MODEL=arcana
RIME_SPEAKER=astra
RIME_LANG=hin
# Used by the default English Talk mode. Hinglish uses RIME_SPEAKER/RIME_LANG above.
RIME_SPEAKER_EN=cove
RIME_LANG_EN=eng
RIME_MODEL_EN=mistv3

# Groq — STT and LLM fallback
GROQ_API_KEY=replace_with_groq_secret
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# NVIDIA NIM — optional primary LLM
NVIDIA_API_KEY=replace_with_nvidia_secret
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct

# LiveKit — browser/agent real-time transport
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Speaker-verification sidecar (started automatically by ./run-all.sh)
SPEAKER_ID_ENABLED=true
SPEAKER_ID_URL=http://localhost:8788
SPEAKER_ID_THRESHOLD=0.70
