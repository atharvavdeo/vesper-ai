# Copy to .env for local development. Never commit .env or replace placeholders
# with real credentials in documentation, screenshots, or client-side variables.

# Project data
SITE_DB_PATH=../data/site.db
PROJECT_ID=P1

# Clerk — account authentication for the /app operational console
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_SITE_URL=https://your-deployed-site.example
CLERK_JWT_ISSUER=https://your-instance.clerk.accounts.dev
FREE_COMMAND_LIMIT=3
# false locally; set true in every public deployment
ENFORCE_FREE_COMMAND_LIMIT=false
DEMO_SEED_EMAIL=atharva.v.deo@gmail.com

# Rime TTS — organizer configuration
RIME_API_KEY=replace_with_rime_secret
RIME_MODEL=arcana
RIME_SPEAKER=astra
RIME_LANG=hin
# Used by the default English Talk mode. Hinglish uses RIME_SPEAKER/RIME_LANG above.
RIME_SPEAKER_EN=cove
RIME_LANG_EN=eng
RIME_MODEL_EN=mistv3

# Sarvam — primary STT (saaras:v3; live agent streams saaras:v3-realtime)
SARVAM_API_KEY=replace_with_sarvam_secret
STT_PROVIDER=sarvam
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
# auto-detect (agent websocket: auto, REST: unknown — either spelling is accepted)
SARVAM_STT_LANGUAGE=auto
SARVAM_STT_KEYTERMS=true

# Groq — primary LLM, STT fallback
GROQ_API_KEY=replace_with_groq_secret
GROQ_STT_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b

# NVIDIA NIM — third LLM fallback
NVIDIA_API_KEY=replace_with_nvidia_secret
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=openai/gpt-oss-120b

# LiveKit — browser/agent real-time transport
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Speaker-verification sidecar (started automatically by ./run-all.sh)
SPEAKER_ID_ENABLED=true
SPEAKER_ID_URL=http://localhost:8788
SPEAKER_ID_THRESHOLD=0.70

# Cerebras — second LLM in the chain (Groq → Cerebras → NVIDIA)
CEREBRAS_API_KEY=
CEREBRAS_LLM_MODEL=gpt-oss-120b

# Resend — onboarding / invite / ingest emails (backend/emails). Without template ids the backend
# sends its built-in HTML. The test sender only delivers to the Resend account owner; invites to
# anyone else need a verified domain in RESEND_FROM. Variable names per template: docs/plan/reports/W2.md
RESEND_API_KEY=replace_with_resend_secret
RESEND_FROM=Vesper <onboarding@resend.dev>
RESEND_TEMPLATE_WELCOME=
RESEND_TEMPLATE_PROJECT_CREATED=
RESEND_TEMPLATE_INVITE=
RESEND_TEMPLATE_INGEST=

# Memory layer (backend/memory) runs locally: Ollama bge-m3 embeddings, bge-reranker-v2-m3,
# LanceDB vectors in data/memory/, SQLite FTS5 + tenancy in data/app.db, Cognee graph.
# Model and threshold settings: backend/memory/config.py and docs/plan/reports/W1.md
OLLAMA_HOST=http://127.0.0.1:11434
